rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: apna data dekh sako, admin sabki list dekh sake
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId;
    }

    // Tours: sabhi dekh sako, sirf admin likh sake
    // EXCEPTION: booking ke time customer sirf seats update kar sakta hai
    match /tours/{tourId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['bookedSeats', 'availableSeats']));
    }

    // Buses: sabhi dekh sako, sirf admin likh sake
    match /buses/{busId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings: apni booking dekho aur banao, admin sab manage kare
    match /bookings/{bookingId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
